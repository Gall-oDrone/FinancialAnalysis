# =============================================================================
# Financial Analysis - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values:
#   cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=False

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Use localhost when running notebooks/scripts on the host.
# Docker Compose overrides PGDBHOST to "postgres" inside containers.
PGDBHOST=localhost
PGDBPORT=5432
PGDBNAME=financial_db
PGDBUSER=financial_user
PGDBPASS=your_secure_password_here

# PostgreSQL container settings
POSTGRES_DB=financial_db
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# pgAdmin Configuration
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin_password_here
PGADMIN_LISTEN_PORT=80

# -----------------------------------------------------------------------------
# Web Scraping Configuration
# -----------------------------------------------------------------------------
SCRAPING_DEBUG=False
SCRAPING_HEADLESS=True
SCRAPING_TIMEOUT=30
SCRAPING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# News collector (docker compose scraper service; override via scripts/run_news_collector.sh)
NEWS_SCRAPE_TOPICS=crypto
NEWS_SCRAPE_SKIP_SCROLLING=false
NEWS_SCRAPE_MAX_ARTICLES=0
NEWS_SCRAPE_SCROLL_TIMEOUT=3

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# AWS S3 Configuration (required for S3 export in DataIngestion notebooks)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_DEFAULT_BUCKET=your-news-bucket-name
# AWS_NEWS_BUCKET=your-news-bucket-name
# AWS_DEFAULT_STOCKS_BUCKET=your-stocks-bucket-name
# AWS_STOCKS_BUCKET=your-stocks-bucket-name  # legacy alias for AWS_DEFAULT_STOCKS_BUCKET
# AWS_BACKUP_BUCKET=your-backup-bucket-name

# Postgres S3 backups (scripts/backup_postgres_to_s3.sh, scripts/restore_postgres_from_s3.sh)
# POSTGRES_BACKUP_S3_PREFIX=postgres-backups/financial_db

# -----------------------------------------------------------------------------
# ML/NLP Configuration
# -----------------------------------------------------------------------------
# Sentiment analysis backend: vader (fast), textblob (fast), transformers (accurate)
ML_SENTIMENT_BACKEND=vader

# Use transformer models for intent classification (slower but more accurate)
ML_USE_TRANSFORMER_INTENTS=False

# Keyword extraction method: tfidf, spacy, rake
ML_KEYWORD_METHOD=tfidf
ML_KEYWORD_TOP_N=10

# Custom model paths (optional)
# ML_SENTIMENT_MODEL_PATH=/path/to/model
ML_SPACY_MODEL=en_core_web_sm

# -----------------------------------------------------------------------------
# Pipeline Configuration
# -----------------------------------------------------------------------------
# Default topics to scrape (comma-separated)
PIPELINE_DEFAULT_TOPICS=crypto

# Whether to fetch full article content
PIPELINE_ENRICH_CONTENT=True

# Continue pipeline on stage errors
PIPELINE_CONTINUE_ON_ERROR=True

# S3 path prefixes
PIPELINE_S3_RAW_PREFIX=raw/news
PIPELINE_S3_TRANSFORMED_PREFIX=transformed/news

# Database table for transformed data
PIPELINE_DB_TABLE=financial_news_transformed

# -----------------------------------------------------------------------------
# LLM / Agentic AI (ETL-Transform-Text.ipynb, agentic pipeline)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_ENABLE_AGENTIC_TRANSFORM=false

# -----------------------------------------------------------------------------
# Selenium/Chrome Configuration
# -----------------------------------------------------------------------------
# Chrome runs in container, these are set automatically
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
